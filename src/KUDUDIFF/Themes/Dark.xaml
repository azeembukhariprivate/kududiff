<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KUDUDIFF Dark theme. KUDU family palette with a purple accent, plus status and comparison colours. -->
    <Color x:Key="TextColor">#F2F2F2</Color>
    <Color x:Key="SelectionColor">#2E2149</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#272727"/>
    <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="SubtleText" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Accent" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkText" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#2E2149"/>
    <SolidColorBrush x:Key="HoverBg" Color="#353535"/>
    <SolidColorBrush x:Key="ChipBg" Color="#2E2149"/>
    <SolidColorBrush x:Key="ChipText" Color="#DDD6FE"/>
    <SolidColorBrush x:Key="NeutralChipBg" Color="#353535"/>
    <SolidColorBrush x:Key="BannerBg" Color="#2E2149"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#B3202020"/>
    <SolidColorBrush x:Key="OkText" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="OkBg" Color="#1E3A1E"/>
    <SolidColorBrush x:Key="WarnText" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarnBg" Color="#433519"/>
    <SolidColorBrush x:Key="BadText" Color="#FF99A4"/>
    <SolidColorBrush x:Key="BadBg" Color="#442726"/>
    <SolidColorBrush x:Key="MonoBg" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="OffDot" Color="#8A8A8A"/>

    <!-- The comparison: added (green), removed (red), changed (blue) and moved (amber) lines, and the changed words in them. -->
    <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="GutterText" Color="#6E7681"/>
    <SolidColorBrush x:Key="DiffInsertBg" Color="#13291B"/>
    <SolidColorBrush x:Key="DiffInsertLine" Color="#3FB950"/>
    <SolidColorBrush x:Key="DiffDeleteBg" Color="#301619"/>
    <SolidColorBrush x:Key="DiffDeleteLine" Color="#F85149"/>
    <SolidColorBrush x:Key="DiffChangeBg" Color="#15243A"/>
    <SolidColorBrush x:Key="DiffChangeLine" Color="#58A6FF"/>
    <SolidColorBrush x:Key="DiffInlineInsert" Color="#22603A"/>
    <SolidColorBrush x:Key="DiffInlineDelete" Color="#78262D"/>
    <SolidColorBrush x:Key="DiffMoveBg" Color="#31270F"/>
    <SolidColorBrush x:Key="DiffMoveLine" Color="#D29922"/>
    <SolidColorBrush x:Key="DiffCurrent" Color="#A78BFA"/>

    <!-- Built-in WPF parts (menus, dropdown lists, text selection) read these. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E2149"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2E2149"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F2"/>
</ResourceDictionary>
