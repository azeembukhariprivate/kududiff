<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUDIFF</AssemblyName>
    <RootNamespace>Kududiff</RootNamespace>
    <ApplicationIcon>Assets\KUDUDIFF.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>Kududiff.Program</StartupObject>

    <Version>1.0.0</Version>
    <Product>KUDUDIFF</Product>
    <Company>Azeem Bukhari</Company>
    <Authors>Azeem Bukhari</Authors>
    <Copyright>Copyright © 2026 Azeem Bukhari</Copyright>
    <Description>KUDUDIFF - compare files and see what changed</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    The screens are built in C# and the themes are XAML files loaded at startup, so the project
    needs no XAML compiler and builds with the plain .NET SDK on any operating system.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The text editor: line numbers, syntax colouring, fast with big files (MIT). -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\*.xaml" LogicalName="Kududiff.Themes.%(Filename).xaml" />
    <EmbeddedResource Include="Highlighting\*.xshd" LogicalName="Kududiff.Highlighting.%(Filename).xshd" />
    <EmbeddedResource Include="Assets\KUDUDIFF.ico" LogicalName="Kududiff.Assets.KUDUDIFF.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
